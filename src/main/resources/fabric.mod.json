{
	"schemaVersion": 1,
	"id": "yap-chat",
	"version": "${version}",
	"name": "Yap Chat",
	"description": "A modern chat replacement: styled message boxes with icons and heads, chat bubbles above players and a full settings screen.",
	"authors": [
		"Softfoxxy",
		"DDev14"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/yap-chat",
		"sources": "https://github.com/Dev14dbq/Yap-Chat",
		"issues": "https://github.com/Dev14dbq/Yap-Chat/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/yap-chat/logo.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.ddev14.yapchat.YapChatMod"
		],
		"client": [
			"com.ddev14.yapchat.YapChatModClient"
		],
		"modmenu": [
			"com.ddev14.yapchat.ModMenuIntegration"
		]
	},
	"mixins": [
		"yap-chat.mixins.json",
		{
			"config": "yap-chat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}